# CamHub - Public Uploads Directory Hardening
# Mencegah eksekusi skrip PHP / CGI / SSI di folder unggahan berkas publik

# Matikan engine PHP jika modul PHP aktif
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Tolak akses langsung ke berkas berekstensi skrip berbahaya
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|cgi|pl|py|sh|bash|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Matikan directory listing (browsing folder)
Options -Indexes -ExecCGI
