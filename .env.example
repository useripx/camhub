# ==========================================
# CAMHUB ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Application
APP_NAME=CamHub
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/camhub/public
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (MySQL / Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=camhub_db
DB_USER=root
DB_PASS=

# Session Security
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Payment Gateway (Placeholder for Phase 10)
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_SERVER_KEY=your_server_key_here
PAYMENT_CLIENT_KEY=your_client_key_here
PAYMENT_IS_PRODUCTION=false
